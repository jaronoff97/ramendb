// prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  // pg_trgm is what makes the ILIKE '%q%' location search indexable.
  // queryCompiler drops the 15 MB native rust engine: prisma compiles queries
  // in typescript and sends them through the driver adapter instead.
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

generator zod {
  provider                         = "prisma-zod-generator"
  createOptionalDefaultValuesTypes = true
  createRelationValuesTypes        = true
  config = "zod-generator.config.json"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id         String   @id @default(cuid())
  workosId   String   @unique
  email      String   @unique
  name       String?
  pictureUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ratings Rating[]
  reviews Review[]
}

model Location {
  id        String   @id @default(cuid())
  slug      String   @unique
  // The OpenStreetMap element this came from, when the map search created it.
  // Unique, so a second "Start Review" on the same pin reuses the row instead
  // of adding ramen-ya-2.
  osmId     String?  @unique
  name      String
  type      String // e.g. "restaurant", "cocktail_bar"
  address   String?
  city      String?
  state     String?
  country   String?
  latitude  Float?
  longitude Float?
  website   String?
  hours     Json? // Structured opening hours
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// @zod .optional()
  dishes   Dish[]
  /// @zod .optional()
  ratings  Rating[]
  /// @zod .optional()
  reviews  Review[]
  /// @zod .optional()
  tags     LocationTag[]
  /// @zod .optional()
  pictures LocationPicture[]

  // The search is `ILIKE '%q%'`, and a leading wildcard rules out a B-tree.
  // A trigram GIN index is the one that answers it.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_name_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_city_trgm_idx")
  @@index([country(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_country_trgm_idx")
}

model Dish {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location  @relation(fields: [locationId], references: [id])
  tags     DishTag[]

  @@index([locationId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String? // e.g. "bowl_type", "ambience", "flavor_profile"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations LocationTag[]
  dishes    DishTag[]
  ratings   RatingTag[]
  reviews   ReviewTag[]
}

model Rating {
  // Numeric rating entries (used to compute aggregates)
  id         String   @id @default(cuid())
  locationId String
  userId     String
  // Half stars, so 0.5 to 5.0 in steps of 0.5. A float, not a decimal: every
  // half step is exact in binary floating point, so there is nothing to round.
  // A check constraint in the migration holds the domain.
  value      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  // optional: reviews that reference this numeric rating
  reviews        Review[]        @relation("RatingToReviews")
  tags           RatingTag[]
  ratingPictures RatingPicture[]

  // A rating feeds an average, so one person gets one score per location.
  @@unique([userId, locationId])
  @@index([locationId])
}

model Review {
  // Textual review content, photos, and optional linkage to a numeric Rating
  id         String   @id @default(cuid())
  locationId String
  userId     String
  ratingId   String? // optional: if this review was submitted together with a numeric rating
  title      String?
  text       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  rating   Rating?  @relation("RatingToReviews", fields: [ratingId], references: [id])

  pictures ReviewPicture[]
  tags     ReviewTag[]

  @@index([locationId])
  @@index([userId])
  @@index([ratingId])
  // The list page orders by newest first.
  @@index([createdAt])
}

// Join rows and pictures belong to their parent, so they cascade. Review,
// Rating and Dish keep the default Restrict against Location and User: a
// location with reviews on it must not disappear by accident.
model LocationTag {
  locationId String
  tagId      String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([locationId, tagId])
  @@index([tagId])
}

model DishTag {
  dishId String
  tagId  String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dishId, tagId])
  @@index([tagId])
}

model RatingTag {
  ratingId String
  tagId    String
  rating   Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ratingId, tagId])
  @@index([tagId])
}

model ReviewTag {
  reviewId String
  tagId    String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([reviewId, tagId])
  @@index([tagId])
}

model LocationPicture {
  id         String   @id @default(cuid())
  locationId String
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model RatingPicture {
  // If you want to allow pictures attached directly to a rating
  id        String   @id @default(cuid())
  ratingId  String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  rating Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  @@index([ratingId])
}

model ReviewPicture {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}
