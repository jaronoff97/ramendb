# Copy to .env.local and fill in the WorkOS values.
# `task` points DATABASE_URL at the compose database on its own, so you only
# need to set DATABASE_URL here if you run npm or prisma directly.

# Sent to the browser. Vite bakes these into the bundle at build time.
VITE_WORKOS_CLIENT_ID=client_...
VITE_WORKOS_API_HOSTNAME=api.workos.com
VITE_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Server only. Never expose these to the browser.
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# At least 32 characters. This seals the session cookie.
WORKOS_COOKIE_PASSWORD=

# The compose database. `task` sets this for you.
DATABASE_URL=postgresql://ramendb:ramendb@localhost:5433/ramendb
