# Copy to .env.local. That file stays out of git.
#
# VITE_ variables reach the browser and Vite bakes them in at build time.
# They are identifiers, not secrets.
VITE_WORKOS_CLIENT_ID=client_...
VITE_WORKOS_API_HOSTNAME=api.workos.com
VITE_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Server only.
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_...
# At least 32 characters. WorkOS uses it to seal the session cookie.
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# `task` overrides this with the compose database, so you only need it if you
# run npm scripts directly.
DATABASE_URL=postgresql://ramendb:ramendb@localhost:5433/ramendb
